{
  "name": "cv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:otherIcons": "tsx scripts/prepare-other-icons.ts",
    "prepare:devIcons:allTypes": "tsx scripts/prepare-all-dev-icons-types.ts",
    "prepare:rawData": "tsx scripts/prepare-raw-data.ts",
    "prepare:devIcons:selected": "tsx scripts/prepare-selected-dev-icons.ts",
    "prepare:devIcons": "npm run prepare:devIcons:allTypes && npm run prepare:rawData && npm run prepare:devIcons:selected",
    "prepare:allIcons": "npm run prepare:otherIcons && npm run prepare:devIcons",
    "prepare:dev": "npm run prepare:content && npm run prepare:allIcons",
    "prepare:content": "node scripts/prepare-content.js",
    "prepare:assets": "node scripts/copy-assets.js",
    "dev": "npm run prepare:dev && npm-run-all --parallel watch:content next:dev",
    "dev:webpack": "npm run prepare:dev && npm run prepare:content && npm-run-all --parallel watch:content next:dev:webpack",
    "next:dev": "next dev",
    "next:dev:webpack": "next dev --webpack",
    "watch:content": "node scripts/watch-content.js",
    "build": "npm run prepare:content && npm run prepare:assets && npm run prepare:allIcons && next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "npm run prepare:devIcons:allTypes && jest",
    "test:watch": "npm run prepare:devIcons:allTypes && jest --watch",
    "prepare": "npx husky",
    "commit": "npx cz"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@mdx-js/language-service": "^0.7.3",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.6",
    "@react-pdf/renderer": "^4.3.2",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/config": "^0.2.1",
    "gray-matter": "^4.0.3",
    "hyphen": "^1.14.1",
    "next": "^16.1.6",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@iconify-json/devicon": "^1.2.62",
    "@iconify/json": "^2.2.474",
    "@iconify/tools": "^5.0.11",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/hyphen": "^1.14.0",
    "@types/jest": "^30.0.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "chokidar-cli": "^3.0.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "npm-run-all": "^4.1.5",
    "semantic-release": "^25.0.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.1",
    "typescript": "^5"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ]
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
